<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Header Title & Subtitle -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="GestureCursor AI"
            android:textColor="#F8FAFC"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="24dp"
            android:text="Spatial Camera Cursor &amp; Touch Bridge"
            android:textColor="#94A3B8"
            android:textSize="14sp" />

        <!-- Card 1: System Permissions Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Required Permissions"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Camera Permission Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Front Camera Access"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnGrantCamera"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="Grant"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Overlay Permission Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="2. Display Over Other Apps"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnGrantOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="Grant"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Accessibility Permission Status Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="3. Accessibility Service (Clicks)"
                    android:textColor="#F1F5F9"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnGrantAccessibility"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:backgroundTint="#334155"
                    android:text="Enable"
                    android:textColor="#38BDF8"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Android 13+ Restricted Settings Helper Note -->
            <TextView
                android:id="@+id/txtRestrictedHelp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="⚠️ If Accessibility is grayed out: Tap 'App Info' (top right in system settings) → 3 dots → Allow restricted settings."
                android:textColor="#F59E0B"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Card 2: Sensitivity & Smoothing Controls -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cursor Sensitivity &amp; Smoothing"
                android:textColor="#38BDF8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Sensitivity Slider -->
            <TextView
                android:id="@+id/lblSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Sensitivity Multiplier: 1.5x"
                android:textColor="#F1F5F9"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBarSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="30"
                android:progress="15" />

            <!-- Smoothing Cutoff Slider -->
            <TextView
                android:id="@+id/lblSmoothing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Jitter Smoothing Cutoff: 1.0 Hz"
                android:textColor="#F1F5F9"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekBarSmoothing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="40"
                android:progress="10" />
        </LinearLayout>

        <!-- Master Service Toggle & Test Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnRecenter"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:text="Recenter (◎)"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnTestClickTarget"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#059669"
                android:text="Test Tap Target"
                android:textColor="#F8FAFC"
                android:textSize="13sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
